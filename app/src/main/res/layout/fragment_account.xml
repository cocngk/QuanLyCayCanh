<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tài khoản"
            android:textColor="@color/brown_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_soft"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_emoji"
                android:gravity="center"
                android:text="🙂"
                android:textSize="28sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHoTen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nguyễn Hữu Khánh"
                    android:textColor="@color/brown_dark"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="khach@caycanh.vn"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvVaiTro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_emoji"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="Khách hàng"
                    android:textColor="@color/brown_dark"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_soft"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvSoDienThoai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Số điện thoại: 0912 345 678"
                android:textColor="@color/brown_dark"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvDiaChi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Địa chỉ: 45 Lê Lợi, Quận 3, TP.HCM"
                android:textColor="@color/brown_dark"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Tiện ích"
            style="@style/Text.Section" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCapNhat"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:gravity="start|center_vertical"
            android:text="Cập nhật thông tin cá nhân"
            android:textAllCaps="false"
            android:textColor="@color/brown_dark"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_edit"
            app:iconTint="@color/brown"
            app:strokeColor="@color/line" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDoiMatKhau"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:text="Đổi mật khẩu"
            android:textAllCaps="false"
            android:textColor="@color/brown_dark"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_lock"
            app:iconTint="@color/brown"
            app:strokeColor="@color/line" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTroChuyen"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:text="Trò chuyện với cửa hàng"
            android:textAllCaps="false"
            android:textColor="@color/brown_dark"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_chat"
            app:iconTint="@color/brown"
            app:strokeColor="@color/line" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDonHang"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:text="Đơn hàng của tôi"
            android:textAllCaps="false"
            android:textColor="@color/brown_dark"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_receipt"
            app:iconTint="@color/brown"
            app:strokeColor="@color/line" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDangXuat"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/red_light"
            android:text="Đăng xuất"
            android:textAllCaps="false"
            android:textColor="@color/red"
            app:cornerRadius="14dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
