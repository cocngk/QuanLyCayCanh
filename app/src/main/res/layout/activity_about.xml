<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brown"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageButton
            android:id="@+id/btnQuayLai"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Quay lại"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            android:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Giới thiệu ứng dụng"
            android:textColor="@color/white"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:background="@drawable/bg_auth_logo"
                    android:clipToOutline="true"
                    android:contentDescription="Cây xanh của cửa hàng"
                    android:scaleType="centerCrop"
                    android:src="@drawable/plant_kim_tien" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="QUẢN LÝ CỬA HÀNG CÂY CẢNH"
                    android:textColor="@color/green"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPhienBan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Phiên bản 1.0"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                style="@style/Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Giới thiệu" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="4dp"
                android:text="Ứng dụng Quản lý cửa hàng cây cảnh giúp người quản trị quản lý cây cảnh, hóa đơn và theo dõi hoạt động kinh doanh một cách dễ dàng, thuận tiện."
                android:textColor="@color/brown_dark"
                android:textSize="14sp" />

            <TextView
                style="@style/Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Chức năng chính" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="6dp"
                android:text="• Quản lý danh sách cây cảnh\n\n• Thêm, sửa và xóa cây cảnh\n\n• Tạo và quản lý hóa đơn\n\n• Thống kê hoạt động kinh doanh\n\n• Quản lý tài khoản quản trị"
                android:textColor="@color/brown_dark"
                android:textSize="14sp" />

            <TextView
                style="@style/Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Thông tin ứng dụng" />

            <TextView
                android:id="@+id/tvThongTinUngDung"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="5dp"
                android:text="Tên ứng dụng: Quản lý cửa hàng cây cảnh\nPhiên bản: 1.0\nNền tảng: Android"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
