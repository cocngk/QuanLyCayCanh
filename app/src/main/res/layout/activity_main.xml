<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- THANH TIÊU ĐỀ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="#087A35"
        android:paddingHorizontal="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Trang chủ"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold"/>

        <ImageView
            android:id="@+id/btnNotification"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="9dp"
            android:src="@drawable/ic_notify"
            android:tint="#FFFFFF"
            android:contentDescription="Thông báo"/>

        <ImageView
            android:id="@+id/btnAccount"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="7dp"
            android:src="@drawable/ic_user"
            android:tint="#FFFFFF"
            android:contentDescription="Tài khoản"/>

    </LinearLayout>

    <!-- NỘI DUNG TRANG CHỦ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- BANNER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="145dp"
                android:background="@drawable/bg_home_banner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:text="Quản lý\ncửa hàng\ncây cảnh"
                    android:textColor="#14532D"
                    android:textSize="25sp"
                    android:textStyle="bold"/>

                <ImageView
                    android:layout_width="125dp"
                    android:layout_height="125dp"
                    android:src="@drawable/bonsai"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_home_card"
                    android:contentDescription="Cây bonsai"/>

            </LinearLayout>

            <!-- TÌM KIẾM VÀ LỌC -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp">

                    <ImageView
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:src="@drawable/ic_search"
                        android:contentDescription="Tìm kiếm"/>

                    <EditText
                        android:id="@+id/edtSearch"
                        android:imeOptions="actionSearch"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:hint="Tìm kiếm cây cảnh..."
                        android:paddingStart="9dp"
                        android:singleLine="true"
                        android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/input_hint" />

                </LinearLayout>

                <TextView
                    android:id="@+id/btnFilter"
                    android:layout_width="82dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="9dp"
                    android:background="@drawable/bg_home_card"
                    android:gravity="center"
                    android:text="☷  Lọc"
                    android:textColor="#1B5E20"
                    android:textStyle="bold"
                    android:textSize="15sp"/>

            </LinearLayout>

            <!-- THẺ TỔNG QUAN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <!-- LOẠI CÂY -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:background="#E8F5E9"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_tree"
                        android:tint="#22A52E"/>

                    <TextView
                        android:id="@+id/tvPlantCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        android:textColor="#111111"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loại cây"
                        android:textSize="12sp"
                        android:textColor="#222222"/>

                </LinearLayout>

                <!-- TỒN KHO -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:background="#FFF5DC"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📦"
                        android:textSize="27sp"/>

                    <TextView
                        android:id="@+id/tvStockCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        android:textColor="#111111"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tồn kho"
                        android:textSize="12sp"
                        android:textColor="#222222"/>

                </LinearLayout>

                <!-- ĐƠN HÀNG -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:background="#E3F2FD"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_bill"
                        android:tint="#2196F3"/>

                    <TextView
                        android:id="@+id/tvInvoiceCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        android:textColor="#111111"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hóa đơn"
                        android:textSize="12sp"
                        android:textColor="#222222"/>

                </LinearLayout>

                <!-- DOANH THU -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:background="#F3E5F5"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="◉"
                        android:textColor="#9C27B0"
                        android:textSize="29sp"/>

                    <TextView
                        android:id="@+id/tvRevenue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 đ"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#111111"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Doanh thu"
                        android:textSize="12sp"
                        android:textColor="#222222"/>

                </LinearLayout>

            </LinearLayout>

            <!-- TIÊU ĐỀ CHỨC NĂNG -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Chức năng quản lý"
                android:textColor="#1B5E20"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <!-- HÀNG CHỨC NĂNG 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="125dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnPlants"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_home_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="43dp"
                        android:layout_height="43dp"
                        android:src="@drawable/ic_tree"
                        android:tint="#159B35"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Quản lý cây cảnh"
                        android:textColor="#164B25"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnCreateBill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="5dp"
                    android:background="@drawable/bg_home_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="43dp"
                        android:layout_height="43dp"
                        android:src="@drawable/ic_create"
                        android:tint="#159B35"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Tạo hóa đơn"
                        android:textColor="#164B25"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnBills"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_home_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="43dp"
                        android:layout_height="43dp"
                        android:src="@drawable/ic_history"
                        android:tint="#159B35"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Quản lý hóa đơn"
                        android:textColor="#164B25"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                </LinearLayout>

            </LinearLayout>

            <!-- HÀNG CHỨC NĂNG 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="125dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnStats"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_home_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="43dp"
                        android:layout_height="43dp"
                        android:src="@drawable/ic_chart"
                        android:tint="#159B35"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Thống kê"
                        android:textColor="#164B25"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnManageAccount"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_home_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="43dp"
                        android:layout_height="43dp"
                        android:src="@drawable/ic_user1"
                        android:tint="#159B35"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Quản lý tài khoản"
                        android:textColor="#164B25"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                </LinearLayout>

            </LinearLayout>

            <!-- TRANG TRÍ CUỐI TRANG -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="105dp"
                android:layout_marginTop="12dp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:src="@drawable/kim_ngan"
                    android:scaleType="centerCrop"
                    android:contentDescription="Cây kim ngân"/>

                <ImageView
                    android:layout_width="105dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/kim_tien"
                    android:scaleType="centerCrop"
                    android:contentDescription="Cây kim tiền"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <include layout="@layout/view_bottom_nav" />

</LinearLayout>
